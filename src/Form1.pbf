Procedure OpenForm1(x = 0, y = 0, width = 919, height = 615)
  OpenWindow(#Form1, x, y, width, height, "Elektroplanung", #PB_Window_SystemMenu | #PB_Window_Invisible | #PB_Window_WindowCentered)
  AddKeyboardShortcut(#Form1, #PB_Shortcut_Control | #PB_Shortcut_X, #FormMenu_Cut)
  AddKeyboardShortcut(#Form1, #PB_Shortcut_Control | #PB_Shortcut_C, #FormMenu_Copy)
  AddKeyboardShortcut(#Form1, #PB_Shortcut_Control | #PB_Shortcut_V, #FormMenu_Paste)
  AddKeyboardShortcut(#Form1, #PB_Shortcut_Delete, #FormMenu_Delete)

  CreateStatusBar(0, WindowID(#Form1))
  AddStatusBarField(50)
  StatusBarText(0, 0, "Label")
  AddStatusBarField(50)
  StatusBarText(0, 1, "Label")
  AddStatusBarField(50)
  StatusBarText(0, 2, "Label")
  AddStatusBarField(50)
  StatusBarText(0, 3, "Label")
  CreateMenu(0, WindowID(#Form1))
  MenuTitle("Datei")
